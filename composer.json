{
	"name": "obbywiki/swetrix",
	"type": "mediawiki-extension",
	"description": "Obby Wiki Swetrix MediaWiki extension",
	"keywords": [
		"MediaWiki",
		"extension"
	],
	"homepage": "https://www.mediawiki.org/wiki/Extension:Swetrix",
	"readme": "README.md",
	"license": "GPL-3.0-or-later",
	"authors": [
		{
			"name": "Wolfite",
			"email": "w@wolfite.dev",
			"homepage": "https://wolfite.dev",
			"role": "Developer"
		},
		{
			"name": "The Obby Wiki",
			"email": "obbywiki@wou.gg",
			"homepage": "https://obby.wiki",
			"role": "Maintainer"
		}
	],
	"autoload": {
		"psr-4": {
			"MediaWiki\\Extension\\Swetrix\\": "src/"
		}
	},
	"require": {
		"composer/installers": ">=1.0.1"
	},
	"require-dev": {
		"mediawiki/mediawiki-codesniffer": "52.0.1",
		"php-parallel-lint/php-console-highlighter": "1.0.0",
		"php-parallel-lint/php-parallel-lint": "1.4.0",
		"phpunit/phpunit": "^13.3"
	},
	"scripts": {
		"phpcs": "phpcs -p -s",
		"phpunit": "phpunit -c phpunit.xml.dist"
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
